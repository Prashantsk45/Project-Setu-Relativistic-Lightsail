! ==============================================================================
! Project Setu: Thermal Finite Element Analysis (SHELL131)
! Author: Prashant S. Kamble
! ==============================================================================
FINISH
/CLEAR,NOSTART
/TITLE,Project Setu: Gaussian Laser Thermal Gradient FEA
/PREP7

! Element: SHELL131 (Thermal Shell)
ET,1,SHELL131
KEYOPT,1,1,1

! Material: Stoichiometric Silicon Nitride (Si3N4)
MP,KXX,1,30.0
MP,DENS,1,3100
MP,C,1,700
MP,EMIS,1,0.95

! Shell thickness: 10.0 um
SECTYPE,1,SHELL
SECDATA,10.0E-6,1,0,3

! Geometry: 4.0 m circular membrane (R = 2.0 m)
CYL4,0,0,2.0

! Mesh sizing
ESIZE,0.08
AMESH,ALL

/SOLU
ANTYPE,0

! Radial Gaussian heat generation zones (W/m^3)
CSYS,1

! Zone 1: Center Core (r = 0.0 to 0.4 m)
ESEL,S,CENT,X,0.0,0.4
BFE,ALL,HGEN,,1.58E10

! Zone 2: Inner Ring (r = 0.4 to 0.8 m)
ESEL,S,CENT,X,0.4,0.8
BFE,ALL,HGEN,,1.15E10

! Zone 3: Middle Ring (r = 0.8 to 1.2 m)
ESEL,S,CENT,X,0.8,1.2
BFE,ALL,HGEN,,6.49E9

! Zone 4: Outer Ring (r = 1.2 to 1.6 m)
ESEL,S,CENT,X,1.2,1.6
BFE,ALL,HGEN,,2.78E9

! Zone 5: Rim Edge (r = 1.6 to 2.0 m)
ESEL,S,CENT,X,1.6,2.05
BFE,ALL,HGEN,,8.94E8

ALLSEL,ALL
CSYS,0

! Dual-sided radiative emission to deep space (2.7 K, h_rad = 85.84 W/m^2.K)
SFE,ALL,1,CONV,,85.84
SFE,ALL,1,CONV,2,2.7
SFE,ALL,2,CONV,,85.84
SFE,ALL,2,CONV,2,2.7

! Perimeter rim heat sink boundary condition (T = 200 K)
CSYS,1
NSEL,S,LOC,X,1.92,2.08
D,ALL,TEMP,200.0
ALLSEL,ALL
CSYS,0

SOLVE
FINISH

! Post-processing: temperature contour
/POST1
SET,LAST
/VIEW,1,1,1,1
/PLOPTS,LEG1,1
PLNSOL,TEMP