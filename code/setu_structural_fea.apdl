! ==============================================================================
! Project Setu: Static Non-Linear Structural Analysis (SHELL181)
! Author: Prashant S. Kamble
! ==============================================================================
FINISH
/CLEAR,NOSTART
/TITLE,Project Setu Lightsail FEA
/PREP7

! Element: SHELL181 (4-node structural shell)
ET,1,SHELL181
KEYOPT,1,3,0

! Material: Stoichiometric Si3N4 (E = 250 GPa, nu = 0.23, rho = 3100 kg/m^3)
MP,EX,1,250E9
MP,PRXY,1,0.23
MP,DENS,1,3100

! Shell section: 10.0 um thickness
SECTYPE,1,SHELL
SECDATA,10.0E-6,1,0,3

! Geometry: 4.0 m circular disk (R = 2.0 m)
CYL4,0,0,2.0

! Outer perimeter clamping boundary condition
DL,ALL,,ALL,0

! Mesh sizing and generation
ESIZE,0.08
AMESH,ALL

! Solution: uniform photon radiation pressure (100 GW beam, p = 53.09 Pa)
/SOLU
ANTYPE,0
SFA,ALL,1,PRES,53.09
SOLVE
FINISH

! Post-processing: Von Mises equivalent stress
/POST1
SET,LAST
/VIEW,1,1,1,1
/PLOPTS,LEG1,1
PLNSOL,S,EQV